# ─────────────────────────────────────────────────────────────
# Toronto Mosaic — environment template. Copy to .env.local.
# Leave the Firebase block empty to run the LOCAL PROTOTYPE
# (in-memory store, signed-cookie sessions, passcode admin).
# ─────────────────────────────────────────────────────────────

# Firebase web config (Project settings → Your apps → Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Public URL used for QR codes and share links (defaults to the current origin)
NEXT_PUBLIC_SITE_URL=

# Organizer allow-list for /admin (Firebase mode, Google sign-in)
ORGANIZER_EMAILS=

# Local prototype mode only
LOCAL_ADMIN_PASSCODE=devfest
SESSION_SECRET=change-me-to-a-long-random-string

# Rehearsal tools (default: on in local mode, off in Firebase mode)
# ALLOW_DEMO_SEED=true
# ALLOW_RESET=true

# Optional Gemini captions (never required)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Emulators (optional, for local Firebase development)
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
