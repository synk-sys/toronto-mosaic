{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "apphosting": {
    "backendId": "toronto-mosaic",
    "rootDir": "/",
    "ignore": ["node_modules", ".git", "firebase-debug.log", "tests", "playwright-report", "test-results"]
  },
  "emulators": {
    "firestore": { "port": 8080 },
    "auth": { "port": 9099 },
    "ui": { "enabled": true, "port": 4000 },
    "singleProjectMode": true
  }
}
